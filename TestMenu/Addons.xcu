<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Addons" oor:package="org.openoffice.Office">
    <node oor:name="AddonUI">
        <node oor:name="OfficeMenuBar">
            <node oor:name="org.cdblue999.WI_Menu" oor:op="fuse">
                <prop oor:name="Title" oor:type="xs:string">
                    <value xml:lang="en-US">WI_Menu</value>
                    <value xml:lang="pl">WI_Menu</value>
                </prop>
                <node oor:name="Submenu" oor:op="fuse">
                    <node oor:name="m1" oor:op="fuse">
                        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Hello World</value></prop>
                        <prop oor:name="URL" oor:type="xs:string"><value>macro:///Standard.Module1.HelloWorld</value></prop>
                    </node>
                    <node oor:name="m2" oor:op="fuse">
                        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Insert Text</value></prop>
                        <prop oor:name="URL" oor:type="xs:string"><value>macro:///Standard.Module1.InsertText</value></prop>
                    </node>
                    <node oor:name="s1" oor:op="fuse">
                        <prop oor:name="SeparatorLine" oor:type="xs:boolean"><value>true</value></prop>
                    </node>
                    <node oor:name="m3" oor:op="fuse">
                        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Set Cell Color</value></prop>
                        <prop oor:name="URL" oor:type="xs:string"><value>macro:///Standard.Module1.SetCellColor</value></prop>
                    </node>
                </node>
            </node>
        </node>
    </node>
</oor:component-data>
